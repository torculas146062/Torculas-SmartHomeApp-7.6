# ---------------------------------------------------------------------------
# IoT backend integration
#
# Copy this file to `.env` and adjust the values for your environment.
#
# Expo CLI inlines every variable prefixed with `EXPO_PUBLIC_` into the client
# bundle at build time, so NEVER put secrets (private keys, service
# credentials, database passwords) in this file — it ships to end users.
# ---------------------------------------------------------------------------

# Base URL of the IoT backend / gateway. No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3000

# "true"  -> use the local in-memory simulation in `src/services/mock`
# "false" -> talk to the real backend at EXPO_PUBLIC_API_URL
EXPO_PUBLIC_USE_MOCK_API=true

# Abort API requests that take longer than this (milliseconds).
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Timeout for the lightweight `GET /health` gateway probe (milliseconds).
EXPO_PUBLIC_HEALTHCHECK_TIMEOUT_MS=5000

# Probability (0..1) that a *simulated* request fails. Mock mode only.
EXPO_PUBLIC_MOCK_FAILURE_RATE=0.15
