# ---------------------------------------------------------------------------
# Smart Home backend configuration
#
# Copy this file to `.env` and adjust for your environment. These values stay
# server-side only and are NEVER bundled into the mobile app.
# ---------------------------------------------------------------------------

# --- HTTP server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins, or `*` for any.
CORS_ORIGIN=*

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smarthome
DB_CONNECTION_LIMIT=10
# Fail fast when MySQL is unreachable (milliseconds).
DB_CONNECT_TIMEOUT_MS=3000
